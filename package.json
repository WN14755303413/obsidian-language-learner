{
    "name": "obsidian-sample-plugin",
    "version": "1.0.1",
    "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
    "main": "main.js",
    "scripts": {
        "build": "npm run check && npm run lint && vite build --mode production",
        "check": "vue-tsc -p tsconfig.app.json --noEmit --skipLibCheck",
        "dev": "vite build --mode development",
        "eol:check": "node scripts/check-line-endings.mjs --check-staged",
        "eol:fix": "node scripts/check-line-endings.mjs --fix",
        "eol:fix-modified": "node scripts/check-line-endings.mjs --fix-modified",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "pub": "node scripts/publish.mjs",
        "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@vueuse/core": "^9.6.0",
        "ac-auto": "^2.0.0",
        "dexie": "^3.2.2",
        "dexie-export-import": "^1.0.3",
        "downloadjs": "^1.4.7",
        "echarts": "^5.3.2",
        "monkey-around": "^2.3.0",
        "nlcst-to-string": "^3.1.0",
        "parse-english": "^5.0.0",
        "retext-english": "^4.1.0",
        "unified": "^10.1.2",
        "unist-util-modify-children": "^3.0.0",
        "unist-util-visit": "^4.1.0",
        "vue": "^3.5.39"
    },
    "devDependencies": {
        "@types/downloadjs": "^1.4.3",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/tsconfig": "^0.9.1",
        "naive-ui": "2.44.1",
        "obsidian": "^1.11.0",
        "octokit": "^5.0.5",
        "oxlint": "^1.38.0",
        "sass": "^1.56.1",
        "tslib": "2.8.1",
        "typescript": "~5.9.3",
        "vite": "^8.1.4",
        "vue-tsc": "^3.3.7"
    }
}
